set(LANAUDIO_INSTALLED_APP
  "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/LanAudio.app")

set(ENV{OPENSSL_ROOT_DIR} "@OPENSSL_ROOT_DIR@")
execute_process(
  COMMAND "@Python3_EXECUTABLE@"
          "@CMAKE_SOURCE_DIR@/tools/macos/bundle_dependencies.py"
          "${LANAUDIO_INSTALLED_APP}"
          "@LANAUDIO_QT_LIBRARY_DIR@"
  RESULT_VARIABLE LANAUDIO_BUNDLE_RESULT
  OUTPUT_VARIABLE LANAUDIO_BUNDLE_OUTPUT
  ERROR_VARIABLE LANAUDIO_BUNDLE_ERROR)

if(NOT LANAUDIO_BUNDLE_RESULT EQUAL 0)
  message(FATAL_ERROR
    "Bundling non-system dependencies failed: ${LANAUDIO_BUNDLE_OUTPUT}"
    "${LANAUDIO_BUNDLE_ERROR}")
endif()
